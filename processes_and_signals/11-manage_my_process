#!/usr/bin/env bash
# Init script that starts, stops or restarts the manage_my_process script
pid_file="/var/run/my_process.pid"
dir="$(dirname "$0")"

start_process() {
    "$dir/manage_my_process" &
    echo "$!" > "$pid_file"
}

stop_process() {
    if [ -f "$pid_file" ]
    then
        kill "$(cat "$pid_file")"
        rm -f "$pid_file"
    fi
}

case "$1" in
    start)
        start_process
        echo "manage_my_process started"
        ;;
    stop)
        stop_process
        echo "manage_my_process stopped"
        ;;
    restart)
        stop_process
        start_process
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac
