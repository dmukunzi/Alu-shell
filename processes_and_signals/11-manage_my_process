#!/usr/bin/env bash
# Init script that starts, stops and restarts the manage_my_process script
PID_FILE="/var/run/my_process.pid"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

do_start() {
    "$SCRIPT_DIR/manage_my_process" > /dev/null 2>&1 &
    echo "$!" > "$PID_FILE"
}

do_stop() {
    if [ -f "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
    fi
}

case "$1" in
    start)
        do_start
        echo "manage_my_process started"
        ;;
    stop)
        do_stop
        echo "manage_my_process stopped"
        ;;
    restart)
        do_stop
        do_start
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac
